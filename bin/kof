#!/usr/bin/env bash
#
# kof — Kof platform launcher.
#
# Uses the embedded OpenJDK shipped with the official distribution when
# present (jdk/ next to bin/). Falls back to a system `java` only in
# development builds that do not carry an embedded JDK.
#
# Resolves symlinks so the distribution can be invoked from anywhere.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
KOF_BIN="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
KOF_HOME="$(dirname "$KOF_BIN")"

JAR="$KOF_HOME/lib/kof.jar"
if [ ! -f "$JAR" ]; then
    echo "kof: distribution incomplete — missing $JAR" >&2
    echo "kof: build it with: mvn clean package -DskipTests && scripts/package.sh" >&2
    exit 1
fi

EMBEDDED=false
JAVA="$(command -v java || true)"
if [ -x "$KOF_HOME/jdk/bin/java" ]; then
    JAVA="$KOF_HOME/jdk/bin/java"
    EMBEDDED=true
fi
if [ -z "$JAVA" ]; then
    echo "kof: no java found — install the official Kof distribution (it embeds a JDK)" >&2
    exit 1
fi

# KofJS embeds a JavaScript engine (GraalJS/Truffle) in the Kof process;
# quiet the JDK warnings it emits when it initializes on stock JDKs.
# The Unsafe-access option only exists on JDK 24+; the embedded JDK is
# Temurin 21, so the flag is added only when the runtime supports it.
UNSAFE_FLAG=""
JAVA_MAJOR="$("$JAVA" -version 2>&1 | sed -n 's/.*version "\([0-9]*\).*/\1/p' | head -1)"
if [ -n "$JAVA_MAJOR" ] && [ "$JAVA_MAJOR" -ge 24 ] 2>/dev/null; then
    UNSAFE_FLAG="--sun-misc-unsafe-memory-access=allow"
fi
exec "$JAVA" --enable-native-access=ALL-UNNAMED $UNSAFE_FLAG \
    -Dkof.install.dir="$KOF_HOME" -Dkof.embedded.jdk="$EMBEDDED" \
    -jar "$JAR" "$@"