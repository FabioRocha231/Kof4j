// kof.security — senhas, JWT, crypto e segredos (docs/security.md)
// Intenção direta, secure by default.

main() {
    // Passwords: hash + verificação constant-time, formato versionado
    var hash = passwords.hash("hunter2")
    println(passwords.verify("hunter2", hash))   // true
    println(passwords.verify("wrong", hash))     // false
    println(passwords.needsRehash(hash))         // false (parâmetros atuais)

    // Crypto: digests e HMAC idênticos entre JVM/Native/JS
    println(crypto.sha256("kof"))
    println(crypto.hmacSha256("key", "data"))

    // AES-GCM com chave segura (round trip + detecção de tamper)
    var key = crypto.randomHex(32)
    var ct = crypto.encryptAesGcm("segredo", key)
    println(crypto.decryptAesGcm(ct, key) == "segredo")

    // JWT: HS256 fixo, exp/iss/aud validados
    var token = jwt.create("{\"sub\":\"u1\",\"roles\":[\"admin\"],\"iss\":\"kof\",\"aud\":\"api\"}", "s3cret")
    var claims = jwt.verify(token, "s3cret", "kof", "api")
    println(claims.contains("admin"))

    // Segredos: env + redação para logs
    println(secrets.get("KOF_DEMO", "default-value") == "default-value")
    println(secrets.redact("sk-abcdefghijklmnop") == "sk-a********mnop")

    // Comparação constant-time
    println(security.constantTimeEquals("abc", "abc"))
}