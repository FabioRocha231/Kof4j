main() {
    var n = 1500
    var a = new Int[n]
    for (var i = 0; i < n; i++) {
        a[i] = n - i
    }
    for (var i = 0; i < n; i++) {
        for (var j = 0; j < n - i - 1; j++) {
            if (a[j] > a[j + 1]) {
                var t = a[j]
                a[j] = a[j + 1]
                a[j + 1] = t
            }
        }
    }
    println(a[0])
    println(a[n - 1])
}