record Point(Int x, Int y)

main() {
    var acc = 0
    for (var i = 0; i < 2000; i++) {
        var a = new Int[1024]
        for (var j = 0; j < 1024; j++) {
            a[j] = j
        }
        acc = acc + a[1023]
        var p = Point(i, i + 1)
        acc = acc + p.x()
    }
    println(acc)
}