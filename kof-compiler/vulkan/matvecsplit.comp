// matvecsplit.comp — M36.3: W pré-split (wh/wl i32) + x pré-split (xh/xl
// i32) → y i64 bit-exato com o CPU.
// w = wh*1e6 + wl (|wh| < 2^31); x = xh*1e6 + xl.
// y[i] = (wh·xh)*1e12 + (wh·xl + wl·xh)*1e6 + (wl·xl) — acumulador i64
// (o produto wl·xl < 1e12 cabe; wh·xh < 4e8*1e12 < 2^63 ok).
// Push 24B {m,k,divId,pad,div:i64}; div > 1 → trunc zero.
// Bindings: 0=wh 1=wl 2=xh 3=xl 4=y.

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer WHBuf { int wh[]; };
layout(std430, binding = 1) readonly buffer WLBuf { int wl[]; };
layout(std430, binding = 2) readonly buffer XHBuf { int xh[]; };
layout(std430, binding = 3) readonly buffer XLBuf { int xl[]; };
layout(std430, binding = 4) writeonly buffer YBuf { int64_t y[]; };

layout(push_constant) uniform Push {
    int m;
    int k;
    int divId;
    int pad;
    int64_t div;
} pcs;

shared int64_t pT[64];  // termo 1e12 (wh·xh)
shared int64_t pM[64];  // termo 1e6  (wh·xl + wl·xh)
shared int64_t pU[64];  // termo 1    (wl·xl)

void main() {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    int k = pcs.k;
    int64_t aT = int64_t(0);
    int64_t aM = int64_t(0);
    int64_t aU = int64_t(0);
    for (int j = int(lane); j < k; j += 64) {
        int idx = int(row) * k + j;
        int64_t whj = int64_t(wh[idx]);
        int64_t wlj = int64_t(wl[idx]);
        int64_t xhj = int64_t(xh[j]);
        int64_t xlj = int64_t(xl[j]);
        aT += whj * xhj;
        aM += whj * xlj + wlj * xhj;
        aU += wlj * xlj;
    }
    pT[lane] = aT;
    pM[lane] = aM;
    pU[lane] = aU;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1u) {
        if (lane < s) {
            pT[lane] += pT[lane + s];
            pM[lane] += pM[lane + s];
            pU[lane] += pU[lane + s];
        }
        barrier();
    }
    if (lane == 0u) {
        int64_t total = pT[0] * int64_t(1000000) * int64_t(1000000)
                      + pM[0] * int64_t(1000000)
                      + pU[0];
        int64_t d = pcs.div;
        if (d > int64_t(1)) {
            total = total / d;
        }
        y[int(row)] = total;
    }
}
